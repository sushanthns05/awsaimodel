# Frontend Environment Variables (Firebase Hosting / Local Vite)

# Backend FastAPI URL (Render Web Service or Local Dev)
VITE_API_BASE_URL=http://localhost:8000

# AWS Cognito Auth Settings
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Enable dev auth bypass during local UI development
VITE_DEV_AUTH=false

