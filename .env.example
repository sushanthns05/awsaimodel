# =============================================================================
# AWS Student Builder Group (SJBIT) - Recruitment Platform Environment Template
# =============================================================================

# Deployment Environment: development | staging | production
ENVIRONMENT=development
STAGE=dev
PORT=8000
HOST=0.0.0.0

# Organization Details
ORG_NAME="AWS Student Builder Group"
INSTITUTION="SJB Institute of Technology"
RECRUITMENT_CYCLE="2026-27"

# AWS Region & Infrastructure
AWS_REGION=ap-south-1
APPLICANTS_TABLE=sbg-applicants-prod
EVALUATIONS_TABLE=sbg-evaluations-prod
AUDIT_TABLE=sbg-audit-prod
CONFIG_TABLE=sbg-config-prod
REPORTS_TABLE=sbg-reports-prod
RESUME_BUCKET=sbg-resumes-prod
REPORT_BUCKET=sbg-reports-prod
PROCESSING_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/sbg-recruitment-queue

# AI Provider Configuration (DeepSeek V4.1 Flash via OpenAI-compatible API)
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
AI_API_KEY=your-deepseek-api-key-here
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=4
AI_TEMPERATURE=0.1

# Google Apps Script Intake Integration
INTAKE_KEY=your-secure-shared-intake-secret-here
INTAKE_SIGNATURE_REQUIRED=true
INTAKE_SIGNATURE_TOLERANCE_SECONDS=900

# Authentication (Cognito or Local Dev)
AUTH_DISABLED=false
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=ap-south-1

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=https://sbg-recruitment-sjbit.web.app

# Local File-Backed Emulation (Set to true for local offline development)
USE_LOCAL_STORE=false
LOCAL_INLINE_PROCESSING=false

