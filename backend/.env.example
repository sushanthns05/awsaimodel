# Backend FastAPI Service Environment Variables (Render Web Service & Worker)

ENVIRONMENT=production
STAGE=prod
PORT=8000
HOST=0.0.0.0

AWS_REGION=ap-south-1
APPLICANTS_TABLE=sbg-applicants-prod
EVALUATIONS_TABLE=sbg-evaluations-prod
AUDIT_TABLE=sbg-audit-prod
CONFIG_TABLE=sbg-config-prod
REPORTS_TABLE=sbg-reports-prod
RESUME_BUCKET=sbg-resumes-prod
REPORT_BUCKET=sbg-reports-prod
PROCESSING_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/sbg-recruitment-queue

AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
AI_API_KEY=your-deepseek-api-key-here

INTAKE_KEY=your-secure-shared-intake-secret-here
INTAKE_SIGNATURE_REQUIRED=true

AUTH_DISABLED=false
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

CORS_ORIGIN=https://sbg-recruitment-sjbit.web.app

